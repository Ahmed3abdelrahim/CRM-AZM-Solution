DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm
REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=crm-minio
MINIO_SECRET_KEY=crm-minio-secret
MINIO_BUCKET=crm-attachments
MINIO_SECURE=false

LITELLM_API_BASE=https://openrouter.ai/api/v1
LITELLM_API_KEY=changeme
LITELLM_MODEL_CHAT=qwen/qwen3-32b
LITELLM_MODEL_CLASSIFY=qwen/qwen3-4b
# PLAN.md F07 default (10s, one retry). docs/DEBT.md D13: local CPU-only inference (e.g. Ollama)
# is slow enough that dev environments typically override LITELLM_TIMEOUT_SECONDS to 60.
LITELLM_TIMEOUT_SECONDS=10
LITELLM_MAX_RETRIES=1

JWT_SECRET=changeme-dev-secret-do-not-use-in-production
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

SYSTEM_DEFAULT_BRANCH_ID=00000000-0000-0000-0000-000000000001
SYSTEM_DEFAULT_DEPARTMENT_ID=00000000-0000-0000-0000-000000000001

CORS_ORIGINS=http://localhost:3000

# F06 — fixed at BAAI/bge-m3 (1024-dim; kb_article_chunks.embedding is vector(1024) and must not
# change). EMBEDDING_DEVICE: "auto" (default) probes CUDA and falls back to CPU; set "cpu" or
# "cuda" to force one. Same .env works on this laptop and on GPU hardware unchanged.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=auto
KB_CHUNK_TOKENS=500
KB_CHUNK_OVERLAP_TOKENS=50

# F06 — reranking is off by default (research.md: 300-800ms/query cost); flip to true once a GPU
# makes the extra latency worth it.
KB_RERANK_ENABLED=false
KB_RERANK_MODEL=BAAI/bge-reranker-v2-m3
